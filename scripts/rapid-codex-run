#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "${script_dir}/.." && pwd)"

export RAPID_REPO_ROOT="${repo_root}"

# Bootstrap the shared launcher from the canonical source tree.  The caller may
# currently be operating inside a different suite workspace (or one that has
# since been removed); those ambient selectors must not override the explicit
# --workspace argument.  suites.staged.codex_launcher installs the selected
# candidate workspace into the child agent environment after parsing it.
export RAPID_WORKSPACE="${repo_root}/workspace"
export RAPID_ACTIVE_SRC_DIR="${repo_root}/workspace/src"
export RAPID_SRC_DIR="${repo_root}/workspace/src"

exec "${script_dir}/rapid-python" -m suites.staged.codex_launcher "$@"
